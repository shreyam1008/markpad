{
  "version": "0.9.2",
  "description": "Quillpane (formerly Markpad) is a small native Markdown notepad and local file viewer. No Electron and no cloud account.",
  "homepage": "https://quillpane.shreyam1008.com.np/",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/shreyam1008/markpad/releases/download/v0.9.2/markpad-setup.exe",
      "hash": "74b26d798d8f649e37ff7c20e4b7e1ee4f2506ada0223a732193932f2e91a67f"
    }
  },
  "installer": {
    "script": [
      "$installer = \"$dir\\markpad-setup.exe\"",
      "Start-Process -Wait -FilePath $installer -ArgumentList '/S'",
      "Remove-Item $installer"
    ]
  },
  "shortcuts": [
    ["C:\\Program Files\\Markpad\\markpad.exe", "Quillpane"]
  ],
  "uninstaller": {
    "script": [
      "$uninstaller = \"C:\\Program Files\\Markpad\\uninstall.exe\"",
      "if (Test-Path $uninstaller) { Start-Process -Wait $uninstaller -ArgumentList '/S' }"
    ]
  },
  "checkver": {
    "github": "https://github.com/shreyam1008/markpad"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/shreyam1008/markpad/releases/download/v$version/markpad-setup.exe"
      }
    }
  }
}
