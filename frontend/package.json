{
  "name": "markpad-frontend",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html",
    "build": "tsc --noEmit && bun run build.ts",
    "build:docs": "bun run build-docs.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin src tests",
    "fmt": "oxfmt src tests build.ts build-docs.ts index.html package.json tsconfig.json bunfig.toml .oxfmtrc.json",
    "fmt:check": "oxfmt --check src tests build.ts build-docs.ts index.html package.json tsconfig.json bunfig.toml .oxfmtrc.json",
    "check": "bun run typecheck && bun run test && bun run lint && bun run fmt:check"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@tanstack/react-hotkeys": "0.10.0",
    "dompurify": "3.4.15",
    "driver.js": "1.8.0",
    "highlight.js": "11.12.0",
    "lucide": "1.45.0",
    "marked": "18.0.12",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
