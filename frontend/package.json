{
  "name": "markpad-frontend",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html",
    "build": "tsc --noEmit && bun run build.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin src tests",
    "fmt": "oxfmt src tests build.ts index.html package.json tsconfig.json bunfig.toml .oxfmtrc.json",
    "fmt:check": "oxfmt --check src tests build.ts index.html package.json tsconfig.json bunfig.toml .oxfmtrc.json",
    "check": "bun run typecheck && bun run test && bun run lint && bun run fmt:check"
  },
  "dependencies": {
    "@tanstack/react-hotkeys": "0.10.0",
    "dompurify": "3.4.13",
    "highlight.js": "11.11.1",
    "lucide": "1.31.0",
    "marked": "18.0.9",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bun-plugin-tailwind": "0.1.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
