{
  "name": "markpad-frontend",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html",
    "build": "tsc --noEmit && bun run build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin src",
    "fmt": "oxfmt src build.mjs index.html package.json tsconfig.json bunfig.toml .oxfmtrc.json",
    "fmt:check": "oxfmt --check src build.mjs index.html package.json tsconfig.json bunfig.toml .oxfmtrc.json",
    "check": "bun run typecheck && bun run lint && bun run fmt:check"
  },
  "dependencies": {
    "dompurify": "latest",
    "highlight.js": "^11.11.1",
    "lucide": "1.31.0",
    "marked": "18.0.9",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "bun-plugin-tailwind": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
