{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markpad.local/schemas/canvas-v1.json",
  "title": "Markpad Canvas v1",
  "description": "Portable local-first Markpad canvas document stored natively as .markcanvas.json. JSON Canvas / Obsidian .canvas compatibility must flow through explicit import/export adapters; transient view/session state should be stored separately.",
  "x-markpad-nativeExtension": ".markcanvas.json",
  "x-markpad-interchangeExtensions": [".canvas"],
  "x-markpad-interchangeFormats": ["json-canvas", "obsidian-canvas"],
  "type": "object",
  "required": ["type", "version", "schema", "source", "elements", "appState", "files"],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      { "required": ["camera"] },
      { "required": ["selection"] },
      { "required": ["tool"] },
      { "required": ["grid"] },
      { "required": ["snap"] },
      { "required": ["minimap"] },
      { "required": ["undo"] },
      { "required": ["history"] },
      { "required": ["cachedBounds"] },
      { "required": ["rasterPreview"] },
      { "required": ["spatialIndex"] }
    ]
  },
  "properties": {
    "type": {
      "description": "Native Markpad discriminator for .markcanvas.json documents.",
      "const": "markpad-canvas"
    },
    "version": {
      "const": 1
    },
    "schema": {
      "description": "Canonical native Markpad schema identifier.",
      "const": "https://markpad.local/schemas/canvas-v1.json"
    },
    "source": {
      "description": "Markpad source or generator name, not an external format discriminator.",
      "type": "string",
      "minLength": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "format": {
          "description": "Native Markpad canvas format marker for .markcanvas.json documents.",
          "const": "markpad-canvas-v1"
        },
        "generator": {
          "description": "Markpad generator or export pipeline identifier.",
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "exportedAt": {
          "type": "string"
        },
        "importedFrom": {
          "description": "Optional provenance for content imported through JSON Canvas / Obsidian .canvas adapters.",
          "type": "string"
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "appState": {
      "type": "object",
      "additionalProperties": true,
      "not": {
        "anyOf": [
          { "required": ["camera"] },
          { "required": ["selection"] },
          { "required": ["tool"] },
          { "required": ["grid"] },
          { "required": ["snap"] },
          { "required": ["minimap"] },
          { "required": ["undo"] },
          { "required": ["history"] },
          { "required": ["cachedBounds"] },
          { "required": ["rasterPreview"] },
          { "required": ["spatialIndex"] }
        ]
      },
      "properties": {
        "viewBackgroundColor": {
          "type": "string",
          "default": "#ffffff"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["path", "text", "sticky", "rect", "ellipse", "line", "arrow"]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "stroke": {
          "type": "string"
        },
        "fill": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "minimum": 1
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": true,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
