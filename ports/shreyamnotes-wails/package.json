{
  "name": "shreyamnotes-wails",
  "private": true,
  "version": "2.8.0",
  "description": "ShreyamNotes Wails/WebKitGTK app, web client, and self-hosted server builds",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "dev": "make wails-run",
    "dev:wails": "make wails-run",
    "dev:web": "bun --filter @zennotes/web dev",
    "dev:server": "bun --filter @zennotes/server dev",
    "dev:web-stack": "bun tooling/scripts/dev-web-stack.mjs",
    "start": "make wails-run",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "build": "turbo run build --filter=!@zennotes/server && bun --filter @zennotes/server build",
    "build:prod": "bun run typecheck && bun run test:run && bun run build",
    "perf:bench": "bun tooling/scripts/perf-large-vault.mjs",
    "perf:runtime-repeat": "bun tooling/scripts/perf-runtime-repeat.mjs",
    "perf:web-runtime": "bun tooling/scripts/perf-web-runtime.mjs",
    "pack": "make wails-build",
    "dist:linux": "make wails-build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "oxlint": "^1.71.0",
    "turbo": "^2.10.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
